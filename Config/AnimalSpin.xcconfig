// AnimalSpin.xcconfig — settings for the app target, in every configuration.

PRODUCT_BUNDLE_IDENTIFIER = com.circuitstitch.toys.animals

// The app ships a checked-in Support/Info.plist, so Xcode must not synthesize one.
GENERATE_INFOPLIST_FILE = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Universal: 1 = iPhone, 2 = iPad.
TARGETED_DEVICE_FAMILY = 1,2

ENABLE_PREVIEWS = YES
